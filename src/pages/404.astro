---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
---

<BaseLayout
	title="Page not found | Ivory Dental Clinic"
	description="The page you requested could not be found. Return to the Ivory Dental Clinic homepage."
>
	<main class="error-page" id="main-content">
		<div class="error-page__card">
			<Logo href="/" />
			<p class="error-page__code" aria-hidden="true">404</p>
			<h1>We couldn’t find that page.</h1>
			<p>The address may be incorrect or the page may have moved.</p>
			<a class="button" href="/">Return to homepage</a>
		</div>
	</main>
</BaseLayout>
