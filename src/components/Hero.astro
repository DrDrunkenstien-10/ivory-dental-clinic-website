---
import { clinic } from '../data/clinic';
import Icon from './Icon.astro';
---

<section class="hero" id="home" aria-labelledby="hero-title">
	<div class="shell hero__inner">
		<p class="eyebrow">Thoughtful dental care in Pune</p>
		<h1 id="hero-title">
			Healthy teeth.<br />
			<em>Happier you.
				<svg class="hero__smile" viewBox="0 0 300 40" aria-hidden="true">
					<path d="M6 8C80 36 220 36 294 8" pathLength="1" />
				</svg>
			</em>
		</h1>
		<p class="hero__lead">Complete dental care delivered with precision, comfort and a gentle approach—for every smile in your family.</p>
		<div class="hero__actions">
			<a class="button" href={clinic.phoneHref} aria-label={`Call ${clinic.name} for an appointment`}>
				<Icon name="phone" size={19} /> Call for appointment
			</a>
			<a class="text-link" href={clinic.mapsQuery} target="_blank" rel="noreferrer">
				Get directions <Icon name="arrow" size={18} />
			</a>
		</div>
		<div class="hero__facts" aria-label="Clinic highlights">
			<div><Icon name="location" size={20} /><span>Bhekarainagar,<br /><strong>Pune</strong></span></div>
			<div><Icon name="clock" size={20} /><span>Open Mon–Sat<br /><strong>Sunday closed</strong></span></div>
		</div>
	</div>

	<div class="ribbon" aria-hidden="true">
		<div class="ribbon__track">
			{[0, 1].map(() => (
				<ul>
					{clinic.treatments.map((treatment) => <li>{treatment.name}</li>)}
				</ul>
			))}
		</div>
	</div>
</section>
