---
import { clinic } from '../data/clinic';

interface Props {
	href?: string;
}

const { href = '#home' } = Astro.props;
---

<a class="logo" href={href} aria-label={`${clinic.name}, ${href === '/' ? 'go to homepage' : 'back to top'}`}>
	<span class="logo__mark" aria-hidden="true">
		<svg viewBox="0 0 42 42" role="img">
			<path d="M13.2 7.3c3.1-1.8 5.3-.6 7.8-.6s4.7-1.2 7.8.6c5.8 3.3 4.2 10.7 1.7 15.7-2.1 4.2-2.5 11.8-6.1 11.8-2.7 0-1.7-7.5-3.4-7.5s-.7 7.5-3.4 7.5c-3.6 0-4-7.6-6.1-11.8-2.5-5-4.1-12.4 1.7-15.7Z" />
			<path d="M26.7 11.3c-1.7 1.2-3.7 1.7-5.7 1.7" />
		</svg>
	</span>
	<span class="logo__text">
		<strong>Ivory</strong>
		<small>Dental Clinic</small>
	</span>
</a>
