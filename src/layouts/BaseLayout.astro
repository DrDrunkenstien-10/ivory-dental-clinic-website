---
import '../styles/global.css';
import '@fontsource/dm-sans/latin-400.css';
import '@fontsource/dm-sans/latin-500.css';
import '@fontsource/dm-sans/latin-600.css';
import '@fontsource/dm-sans/latin-700.css';
import '@fontsource/manrope/latin-400.css';
import '@fontsource/manrope/latin-600.css';
import '@fontsource/manrope/latin-700.css';
import dmSans400 from '@fontsource/dm-sans/files/dm-sans-latin-400-normal.woff2?url';
import manrope600 from '@fontsource/manrope/files/manrope-latin-600-normal.woff2?url';
import { clinic } from '../data/clinic';

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
}

const {
	title = `${clinic.name} | Dentist in Bhekarainagar, Pune`,
	description = 'Visit Ivory Dental Clinic in Bhekarainagar, Pune for preventive, restorative and cosmetic dental care with Dr. Apurva Undre.',
	noindex = false,
} = Astro.props;

const canonicalURL = Astro.site && !noindex ? new URL(Astro.url.pathname, Astro.site) : undefined;
const siteURL = Astro.site ? new URL('/', Astro.site) : undefined;
const sitemapURL = Astro.site ? new URL('sitemap-index.xml', Astro.site) : undefined;
const shareImageURL = Astro.site ? new URL('og-image.jpg', Astro.site) : undefined;
const websiteID = Astro.site ? new URL('/#website', Astro.site).href : undefined;
const dentistID = Astro.site ? new URL('/#dentist', Astro.site).href : undefined;
const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebSite',
			'@id': websiteID,
			url: siteURL?.href,
			name: clinic.name,
			description,
			inLanguage: 'en-IN',
			publisher: { '@id': dentistID },
		},
		{
			'@type': 'Dentist',
			'@id': dentistID,
			url: siteURL?.href,
			name: clinic.name,
			description,
			slogan: clinic.tagline,
			image: shareImageURL?.href,
			hasMap: clinic.googleProfile,
			sameAs: [clinic.googleProfile],
			geo: {
				'@type': 'GeoCoordinates',
				latitude: clinic.geo.latitude,
				longitude: clinic.geo.longitude,
			},
			telephone: '+91-7498227203',
			email: clinic.email,
			address: {
				'@type': 'PostalAddress',
				streetAddress: 'Shri Seva Hospital, Bhekarainagar',
				addressLocality: 'Pune',
				postalCode: '412308',
				addressRegion: 'Maharashtra',
				addressCountry: 'IN',
			},
			employee: {
				'@type': 'Person',
				name: clinic.doctor.name,
				honorificSuffix: clinic.doctor.degree,
				jobTitle: clinic.doctor.specialization,
			},
			openingHoursSpecification: [
				{
					'@type': 'OpeningHoursSpecification',
					dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
					opens: '10:00',
					closes: '13:30',
				},
				{
					'@type': 'OpeningHoursSpecification',
					dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
					opens: '17:30',
					closes: '20:00',
				},
				{
					'@type': 'OpeningHoursSpecification',
					dayOfWeek: 'Saturday',
					opens: '10:00',
					closes: '16:00',
				},
			],
			hasOfferCatalog: {
				'@type': 'OfferCatalog',
				name: 'Dental treatments',
				itemListElement: clinic.treatments.map((treatment) => ({
					'@type': 'Offer',
					itemOffered: {
						'@type': 'Service',
						name: treatment.name,
					},
				})),
			},
		},
	],
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#0b5d5b" />
		<meta name="description" content={description} />
		<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:site_name" content={clinic.name} />
		<meta property="og:locale" content="en_IN" />
		{canonicalURL && <link rel="canonical" href={canonicalURL} />}
		{canonicalURL && <meta property="og:url" content={canonicalURL} />}
		{shareImageURL && <meta property="og:image" content={shareImageURL} />}
		{shareImageURL && <meta property="og:image:width" content="1200" />}
		{shareImageURL && <meta property="og:image:height" content="630" />}
		{shareImageURL && <meta property="og:image:alt" content={`${clinic.name}: Dr. Apurva Undre beside the dental chair`} />}
		<meta name="twitter:card" content={shareImageURL ? 'summary_large_image' : 'summary'} />
		{shareImageURL && <meta name="twitter:image" content={shareImageURL} />}
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{sitemapURL && <link rel="sitemap" href={sitemapURL} />}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.svg" sizes="any" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="preload" as="font" type="font/woff2" href={dmSans400} crossorigin />
		<link rel="preload" as="font" type="font/woff2" href={manrope600} crossorigin />
		<title>{title}</title>
		{!noindex && <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />}
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to main content</a>
		<slot />
	</body>
</html>
